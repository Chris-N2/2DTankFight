{
  "name": "2d-tank-command",
  "version": "0.1.0",
  "private": true,
  "description": "A browser tank battle inspired by Combat for the Atari 2600.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "src/sim",
    "src/protocol",
    "src/client",
    "src/server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @tank/client",
    "dev:server": "npm run dev -w @tank/server",
    "build": "npm run build -w @tank/client",
    "build:server": "npm run build -w @tank/server",
    "preview": "npm run preview -w @tank/client",
    "typecheck": "tsc -p src/sim --noEmit && tsc -p src/protocol --noEmit && tsc -p src/client --noEmit && tsc -p src/client/test --noEmit && tsc -p src/server --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
